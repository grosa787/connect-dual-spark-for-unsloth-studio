#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

package_version='@PACKAGE_VERSION@'
payload_sha256='@PAYLOAD_SHA256@'
payload_marker='__CONNECT_DUAL_SPARK_PAYLOAD_BELOW__'
work_dir=''
language_choice=auto
language=en

select_language() {
    case "$language_choice" in
        en|ru) language=$language_choice ;;
        auto)
            local override="${CONNECT_DUAL_SPARK_LANG:-}"
            override="$(printf '%s' "$override" | tr '[:upper:]' '[:lower:]')"
            case "$override" in
                en|ru) language=$override ;;
                *)
                    local selected_locale="${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}"
                    selected_locale="$(printf '%s' "$selected_locale" | tr '[:upper:]' '[:lower:]')"
                    case "$selected_locale" in
                        ru|ru_*|ru-*|ru.*|ru@*) language=ru ;;
                        *) language=en ;;
                    esac
                    ;;
            esac
            ;;
        *) fail "$(localized "Unsupported language: $language_choice" "Неподдерживаемый язык: $language_choice")" ;;
    esac
}

localized() {
    if [[ "$language" == ru ]]; then printf '%s' "$2"; else printf '%s' "$1"; fi
}

fail() {
    printf 'Connect Dual Spark: %s\n' "$1" >&2
    exit 1
}

cleanup() {
    if [[ -n "$work_dir" && -d "$work_dir" ]]; then
        rm -rf -- "$work_dir"
    fi
}
trap cleanup EXIT

usage() {
    if [[ "$language" == ru ]]; then
        cat <<EOF
Connect Dual Spark for Unsloth Studio ${package_version}

Использование:
  ${0##*/} [команда]       проверить архив и запустить команду
  Команды: install, check, start-rpc, status, studio, refresh, update-unsloth
  ${0##*/} --lang en|ru|auto  выбрать язык установщика
  ${0##*/} --verify       проверить встроенный архив без установки
  ${0##*/} --version      показать версию
EOF
    else
        cat <<EOF
Connect Dual Spark for Unsloth Studio ${package_version}

Usage:
  ${0##*/} [command]  verify, unpack, and start a command
  Commands: install, check, start-rpc, status, studio, refresh, update-unsloth
  ${0##*/} --lang en|ru|auto  choose the installer language
  ${0##*/} --verify   verify the embedded payload without installing
  ${0##*/} --version  print the embedded version
EOF
    fi
}

sha256_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        fail "$(localized 'sha256sum or shasum was not found.' 'не найдена команда sha256sum или shasum.')"
    fi
}

resolve_self() {
    local candidate=${BASH_SOURCE[0]}
    if [[ "$candidate" != */* ]]; then
        candidate="$(command -v "$candidate")"
    fi
    local directory
    directory="$(cd -- "$(dirname -- "$candidate")" && pwd -P)"
    printf '%s/%s\n' "$directory" "$(basename -- "$candidate")"
}

extract_payload() {
    local self_path payload_line archive_path listing_path actual_sha
    self_path="$(resolve_self)"
    payload_line="$(awk -v marker="$payload_marker" '$0 == marker { print NR + 1; exit }' "$self_path")"
    [[ -n "$payload_line" ]] || fail "$(localized 'Embedded archive was not found.' 'встроенный архив не найден.')"

    work_dir="$(mktemp -d "${TMPDIR:-/tmp}/connect-dual-spark.XXXXXXXX")"
    archive_path="$work_dir/payload.tar.gz"
    listing_path="$work_dir/payload.list"
    tail -n +"$payload_line" "$self_path" > "$archive_path"

    actual_sha="$(sha256_file "$archive_path")"
    [[ "$actual_sha" == "$payload_sha256" ]] || \
        fail "$(localized 'Embedded archive checksum does not match.' 'контрольная сумма встроенного архива не совпадает.')"

    tar -tzf "$archive_path" > "$listing_path" || \
        fail "$(localized 'Embedded archive is damaged.' 'встроенный архив повреждён.')"
    if awk '
        /^\// || $0 == ".." || /^\.\.\// || /\/\.\.\// || /\/\.\.$/ { unsafe = 1 }
        END { exit unsafe ? 0 : 1 }
    ' "$listing_path"; then
        fail "$(localized 'Embedded archive contains an unsafe path.' 'встроенный архив содержит небезопасный путь.')"
    fi

    mkdir -m 0700 "$work_dir/payload"
    tar -xzf "$archive_path" -C "$work_dir/payload"
    [[ -f "$work_dir/payload/dual_spark/cli.py" ]] || \
        fail "$(localized 'Embedded archive is missing dual_spark/cli.py.' 'встроенный архив не содержит dual_spark/cli.py.')"
}

run_installer() {
    local payload_dir=$1
    local selected_command=$2
    local result_file="$work_dir/installer.status"
    local terminal_status installer_status

    command -v python3 >/dev/null 2>&1 || fail "$(localized 'python3 was not found.' 'python3 не найден.')"
    command -v gnome-terminal >/dev/null 2>&1 || \
        fail "$(localized 'GNOME Terminal is required to install and view RPC logs.' 'для установки и просмотра журнала RPC требуется GNOME Terminal.')"
    [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] || \
        fail "$(localized 'No GNOME desktop session found; run this file on the DGX Spark desktop.' 'графический сеанс GNOME не найден; запустите файл на рабочем столе DGX Spark.')"

    set +e
    gnome-terminal \
        --wait \
        --title=Connect-Dual-Spark \
        -- \
        bash -c '
            payload_dir=$1
            result_file=$2
            chosen_language=$3
            selected_command=$4
            cd -- "$payload_dir" || exit 1
            PYTHONPATH="$payload_dir${PYTHONPATH:+:$PYTHONPATH}" \
                python3 -m dual_spark.cli --lang "$chosen_language" "$selected_command"
            installer_status=$?
            printf "%s\n" "$installer_status" > "$result_file"
            if [[ "$chosen_language" == ru ]]; then
                printf "\nConnect Dual Spark завершил работу (код %s).\n" "$installer_status"
                printf "Нажмите Enter, чтобы закрыть окно."
            else
                printf "\nConnect Dual Spark finished (exit code %s).\n" "$installer_status"
                printf "Press Enter to close this window."
            fi
            read -r _
            exit "$installer_status"
        ' connect-dual-spark "$payload_dir" "$result_file" "$language" "$selected_command"
    terminal_status=$?
    set -e

    [[ -f "$result_file" ]] || \
        fail "$(localized "GNOME Terminal exited before the installer started (code $terminal_status)." "GNOME Terminal завершился до запуска установщика (код $terminal_status).")"
    installer_status="$(<"$result_file")"
    [[ "$installer_status" =~ ^[0-9]+$ ]] || \
        fail "$(localized 'Installer returned an invalid exit status.' 'установщик вернул некорректный код завершения.')"
    return "$installer_status"
}

main() {
    local action=install
    local selected_command=install
    local command_set=false
    local previous=''
    local argument
    for argument in "$@"; do
        if [[ "$previous" == --lang ]]; then
            language_choice=$argument
            previous=''
            continue
        fi
        case "$argument" in
            --lang) previous=--lang ;;
            --lang=*) language_choice=${argument#--lang=} ;;
        esac
    done
    select_language
    while (( $# )); do
        case "$1" in
            --lang)
                [[ $# -ge 2 ]] || fail "$(localized '--lang requires en, ru, or auto.' 'После --lang укажите en, ru или auto.')"
                language_choice=$2
                shift 2
                ;;
            --lang=*)
                language_choice=${1#--lang=}
                shift
                ;;
            --verify|--version|-h|--help)
                [[ "$action" == install && "$command_set" == false ]] || { usage >&2; return 2; }
                action=$1
                shift
                ;;
            install|check|start-rpc|status|studio|refresh|update-unsloth)
                [[ "$action" == install && "$command_set" == false ]] || { usage >&2; return 2; }
                selected_command=$1
                command_set=true
                shift
                ;;
            *)
                usage >&2
                return 2
                ;;
        esac
    done
    case "$action" in
        --verify)
            extract_payload
            if [[ "$language" == ru ]]; then
                printf 'Проверено: Connect Dual Spark %s, SHA-256 встроенного архива %s\n' \
                    "$package_version" "$payload_sha256"
            else
                printf 'OK: Connect Dual Spark %s, payload SHA-256 %s\n' \
                    "$package_version" "$payload_sha256"
            fi
            return 0
            ;;
        --version)
            printf '%s\n' "$package_version"
            return 0
            ;;
        -h|--help)
            usage
            return 0
            ;;
    esac

    [[ "$(uname -s)" == 'Linux' ]] || \
        fail "$(localized 'Installation requires Ubuntu ARM64.' 'установка поддерживается только на Ubuntu ARM64.')"
    case "$(uname -m)" in
        aarch64|arm64) ;;
        *) fail "$(localized 'Installation requires an ARM64 DGX Spark.' 'установка поддерживается только на ARM64 DGX Spark.')" ;;
    esac

    extract_payload
    run_installer "$work_dir/payload" "$selected_command"
}

main "$@"
exit 0

__CONNECT_DUAL_SPARK_PAYLOAD_BELOW__
